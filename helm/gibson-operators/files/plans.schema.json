{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroroot.ai/schemas/plans.schema.json",
  "title": "Gibson plan registry",
  "description": "The schema of plans.yaml. There is one plan, and it sets no limit on a tenant. The billing webhook and the www and dashboard generators read plans.yaml.",
  "type": "object",
  "required": ["version", "plans"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Registry schema version (informational; bump on breaking changes).",
      "pattern": "^v[0-9]+$"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/plan" }
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "required": ["id", "displayName", "tagline", "pricing", "stripeProductId", "lookupKey", "trialDays"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": ["team"]
        },
        "displayName": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "stripeProductId": {
          "type": "string",
          "minLength": 1,
          "description": "The Stripe product id of the plan."
        },
        "lookupKey": {
          "type": "string",
          "minLength": 1,
          "description": "The Stripe price lookup key. It is the same in every Stripe account and in test and live mode."
        },
        "trialDays": {
          "type": "integer",
          "minimum": 1,
          "description": "The trial length of the card step at signup."
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Display-side pricing metadata. At least one of monthlyUSD/annualUSD/contactSales=true must be present.",
          "properties": {
            "monthlyUSD": { "type": "number", "minimum": 0 },
            "annualUSD": { "type": "number", "minimum": 0 },
            "annualSavingsPct": { "type": "number", "minimum": 0, "maximum": 100 },
            "contactSales": { "type": "boolean" }
          }
        }
      }
    }
  }
}
